{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatze-np-9b4q2m",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatze_db"
    }
