{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bcdef-chtz",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatze_db",
      "database_id": "cae4533a-c9f4-4a92-aa2c-4927452abc0b"
    }
    // Shard databases can be created & bound here if horizontal scaling is enabled:
    // { "binding": "DB_SHARD_1", "database_name": "chatze_shard_1", "database_id": "..." },
    // { "binding": "DB_SHARD_2", "database_name": "chatze_shard_2", "database_id": "..." },
    // { "binding": "DB_SHARD_3", "database_name": "chatze_shard_3", "database_id": "..." },
    // { "binding": "DB_SHARD_4", "database_name": "chatze_shard_4", "database_id": "..." },
    // { "binding": "DB_SHARD_5", "database_name": "chatze_shard_5", "database_id": "..." },
    // { "binding": "DB_SHARD_6", "database_name": "chatze_shard_6", "database_id": "..." },
    // { "binding": "DB_SHARD_7", "database_name": "chatze_shard_7", "database_id": "..." },
    // { "binding": "DB_SHARD_8", "database_name": "chatze_shard_8", "database_id": "..." }
  ],
  // Optional Cloudflare R2 Bucket (10 GB Free Object Storage for Images/Media):
  // Zero-credit card free users don't need this (images automatically save to D1 Shard 8).
  // When ready to upgrade, create a bucket named "chatze-media" and bind "MEDIA_BUCKET"
  // in Cloudflare Dashboard > Settings > Bindings (or uncomment below):
  // "r2_buckets": [
  //   { "binding": "MEDIA_BUCKET", "bucket_name": "chatze-media" }
  // ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_ROOM",
        "class_name": "RealtimeBroadcaster"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RealtimeBroadcaster"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
